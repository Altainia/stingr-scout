{
  "name": "stingr-scout",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "shared",
    "hub/*",
    "app"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run build -w @stingr/app && npm run build -w @stingr/hub-ui",
    "dev:app": "npm run dev -w @stingr/app",
    "hub": "tsx hub/server/src/main.ts",
    "e2e": "playwright test",
    "dev:hub-ui": "npm run dev -w @stingr/hub-ui",
    "package": "tsx scripts/release/build.ts",
    "test:package": "vitest run --config vitest.package.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.13.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
